# Copy this file to terraform.tfvars and customize the values

# AWS Configuration
aws_region = "eu-west-1"

# Project Configuration
project_name = "openremote"
environment  = "dev"

# Network Configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["eu-west-1a", "eu-west-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# EC2 Instance Configuration
ec2_instance_type = "t3.small"       # 2 vCPU, 2GB RAM (~$15/month) - for testing
                                     # For production use: t3.medium (4GB, ~$30/mo) or t3.large (8GB, ~$60/mo)
ec2_volume_size   = 50               # Root volume size in GB
ec2_key_name      = ""               # SSH key pair name (leave empty to use SSM)

# OpenRemote Configuration
openremote_hostname = "localhost"    # Change to your domain name if you have one

# Security Configuration
# IMPORTANT: Restrict these to your IP range for production!
ssh_allowed_cidr_blocks = ["0.0.0.0/0"]  # SSH access - change to your IP: ["1.2.3.4/32"]
allowed_cidr_blocks     = ["0.0.0.0/0"]  # Not used for EC2 deployment

# Feature Flags
enable_vpc_flow_logs = true
single_nat_gateway   = true   # Using single NAT Gateway for cost savings
enable_s3_backups    = true   # Enable S3 bucket for backups
enable_efs           = false  # Enable EFS for map data (set to true if you have large map files)
enable_icmp_ping     = true   # Allow ICMP ping for monitoring
enable_snmp          = false  # Allow SNMP for network monitoring

# Backup Configuration
backup_retention_days = 30  # Days to keep backups in S3

# DNS Configuration (Optional - leave empty to use IP address)
domain_name         = ""  # e.g., "openremote.example.com"
create_route53_zone = false
route53_zone_id     = ""  # Required if using existing Route 53 zone

# Additional Tags
tags = {
  Owner      = "DevOps Team"
  CostCenter = "Engineering"
}

